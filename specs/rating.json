{
  "name": "rating",
  "type": "registry:component",
  "title": "Rating",
  "description": "Interactive star rating with hover preview, keyboard arrows, partial fill and read-only mode.",
  "registryDependencies": [],
  "dependencies": [
    "lucide-react"
  ],
  "files": [
    {
      "path": "registry/rating/rating.tsx"
    }
  ],
  "usage": "<Rating value={rating} onChange={setRating} allowClear />",
  "props": [
    [
      "value",
      "number",
      "Current rating"
    ],
    [
